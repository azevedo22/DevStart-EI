# Copia para .env e ajusta. O .env nunca vai para o Git.
# Cada variável tem o prefixo do serviço, porque todos leem este mesmo ficheiro.

# ── Segurança (partilhado entre gateway e auth-service) ──
# Gera um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sem esta variável, em desenvolvimento usa-se um segredo inseguro (com aviso no arranque).
# JWT_ACCESS_SECRET=

# ── Redis (partilhado: eventos entre serviços e rate limiting) ──
# Vazio desliga os eventos e põe o rate limiting em memória.
REDIS_URL=redis://localhost:6379

# ── API Gateway ──────────────────────────────────────────
GATEWAY_PORT=3000
WEB_ORIGIN=http://localhost:4200
AUTH_SERVICE_URL=http://localhost:3001
PROFILE_SERVICE_URL=http://localhost:3002
TRACKER_SERVICE_URL=http://localhost:3003
# API_RATE_LIMIT_PER_MINUTE=300   # pedidos por minuto por utilizador (ou IP); 0 desliga
# TRUST_PROXY_HOPS=0              # do gateway: 0 em dev, 1 atrás do nginx, 2 com Caddy + nginx

# ── Auth Service ─────────────────────────────────────────
AUTH_SERVICE_PORT=3001
AUTH_DATABASE_URL=postgres://devstart:devstart@localhost:5432/devstart_auth
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7

# ── Profile & Skill Service ──────────────────────────────
PROFILE_SERVICE_PORT=3002
PROFILE_DATABASE_URL=postgres://devstart:devstart@localhost:5432/devstart_profile

# ── Application Tracker Service ──────────────────────────
TRACKER_SERVICE_PORT=3003
TRACKER_DATABASE_URL=postgres://devstart:devstart@localhost:5432/devstart_tracker

# ── Testes e2e ───────────────────────────────────────────
TEST_DATABASE_URL=postgres://devstart:devstart@localhost:5432/devstart_test
TEST_REDIS_URL=redis://localhost:6379

# ── Docker (docker compose --profile app) ────────────────
# O compose lê estas variáveis deste mesmo ficheiro .env. JWT_ACCESS_SECRET é obrigatória.
# WEB_PORT=8080                 # porta do nginx no host
# PUBLIC_URL=http://localhost:8080
# POSTGRES_PASSWORD=devstart    # só tem efeito quando a base de dados é criada
# TRUST_PROXY_HOPS=2            # proxies à frente do auth-service (nginx + gateway)
# DOMAIN=                       # só em produção (docker-compose.prod.yml), ver docs/deploy.md

# ── Contas de demonstração (auth-service) ────────────────
# DEMO_MAX_ACTIVE=200           # máximo de demonstrações ao mesmo tempo; 0 desliga
# DEMO_TTL_HOURS=24             # duração de cada conta de demonstração

# ── Leitura de CVs e anúncios com IA (profile-service) ───
# LLM_PROVIDER=ollama           # ollama (local, grátis) | groq | xai; groq e xai enviam o texto para fora
# As chaves ficam SÓ aqui, nunca no Git nem em mensagens.
# Atenção: Groq (com q, chaves "gsk_") e Grok (com k, da xAI, chaves "xai-") são coisas diferentes.
#
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b         # se não existir, o arranque lista os modelos disponíveis
#
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-non-reasoning
#
# Ollama local: https://ollama.com. Vazio desliga a IA (só deteta palavras-chave).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT_MS=180000

# ── Vagas (ITJobs.pt, profile-service) ───────────────────
# Chave pedida em https://itjobs.pt/api (chega por email). Sem aspas nem espaços.
# Sem chave, a secção Vagas fica vazia e a recolha desligada.
# ITJOBS_API_KEY=
# JOB_SYNC_INTERVAL_MINUTES=180   # de quanto em quanto tempo se vão buscar vagas; 0 desliga
# JOB_SYNC_AI_PER_RUN=10          # quantas vagas novas a IA lê por recolha

# ── Limites da IA (custo, profile-service) ───────────────
# Leituras de CV e anúncios pedidas por utilizadores; a recolha de vagas não conta.
# AI_USER_HOURLY_LIMIT=20         # por utilizador, por hora; 0 desliga
# AI_DAILY_LIMIT=300              # todos juntos, por dia; 0 desliga
