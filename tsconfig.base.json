{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@devstart/shared-types": ["./libs/shared-types/src/index.ts"],
      "@devstart/backend-common": ["./libs/backend-common/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
